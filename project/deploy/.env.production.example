# RAG 学术知识引擎 —— 生产环境配置模板
# 复制为 .env.production 后逐项修改；此文件包含密钥，绝不提交 git。
# compose 会读取本文件；backend 容器的 env_file 也指向它。

# ---------- 编排密钥（compose 插值用） ----------
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_PASSWORD=change-me-app-password

# ---------- 后端必需 ----------
# JWT 签名密钥：openssl rand -hex 32 生成，泄露即所有登录态可伪造
SECRET_KEY=change-me-openssl-rand-hex-32
# system_configs 中 API Key 的 AES-256 加密密钥；留空则回退派生自 SECRET_KEY
# 注意：设定后不可更改，否则已保存的模型 Key 无法解密
CONFIG_ENCRYPTION_KEY=

# 首次启动自动创建的管理员（登录后立即改密码）
INIT_ADMIN_EMAIL=admin@outlook.com
INIT_ADMIN_PASSWORD=change-me-strong-password

# ---------- 后端可选 ----------
# 生产固定 false；模型 Key 在管理后台"系统配置"页填入（AES-256 加密入库）
DEV_MOCK_AI=false
# 同源部署无需跨域，留空；若前端单独域名部署才需要填
CORS_ORIGINS=
