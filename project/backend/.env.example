# ============================================================
# RAG 学术知识引擎 — 后端环境变量示例
# 复制为 backend/.env 后按实际环境修改
# ============================================================

# ---------- 应用 ----------
DEBUG=false

# ---------- 数据库 ----------
# 生产（MySQL 8）：先执行 docs/init_db.sql 建库建表
DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/rag_high?charset=utf8mb4
# 本地快速体验（SQLite，无需安装 MySQL）：
# DATABASE_URL=sqlite:///./data/rag_high.db
DB_ECHO=false

# ---------- 安全（务必修改！） ----------
# JWT 签名密钥，建议 32 位以上随机字符串：openssl rand -hex 32
SECRET_KEY=please-change-me-to-a-long-random-string-at-least-32-bytes
# system_configs 中 API Key 的 AES-256 加密密钥；留空则由 SECRET_KEY 派生。
# 注意：修改此值会导致已存储的密文无法解密，需要在后台重新填写各 API Key。
CONFIG_ENCRYPTION_KEY=
JWT_EXPIRE_SECONDS=604800

# ---------- 跨域 ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 存储 ----------
UPLOAD_DIR=./data/uploads
CHROMA_DIR=./data/chroma
MAX_FILE_SIZE=52428800
MAX_FILES_PER_UPLOAD=10

# ---------- 异步解析线程数 ----------
WORKER_THREADS=4

# ---------- Phase 1 切分器（仅新上传；改回 rag3 并重启即可恢复默认路径） ----------
DOCUMENT_CHUNKING_ENGINE=rag3
RAG4_CHUNKING_VERSION=rag4-structured-v1
# 上传路径使用 Unicode 字符计数 fallback；独立引擎可注入 tokenizer。
RAG4_CHILD_MAX_TOKENS=256
RAG4_PARENT_MAX_TOKENS=1024

# ---------- 超时（秒），对应 PRD [M-6] 降级策略 ----------
QUERY_REWRITE_TIMEOUT=3
RERANK_TIMEOUT=3
LLM_TIMEOUT=30
EMBEDDING_TIMEOUT=30

# ---------- 密码重置频率限制 [M-4] ----------
RESET_REQUEST_INTERVAL_MINUTES=10

# ---------- 初始管理员（仅在库中不存在任何管理员时创建） ----------
INIT_ADMIN_EMAIL=admin@outlook.com
INIT_ADMIN_PASSWORD=please-change-me

# ---------- 实验脚本账号（experiment/run_exp.py 使用） ----------
EXP_EMAIL=exp-lab@outlook.com
EXP_PASSWORD=please-change-me

# ---------- 离线开发开关 ----------
# true：Embedding / LLM / Rerank 全部使用本地 Mock，无需任何外部 API Key，
#       可用于演示与自动化测试。严禁在生产环境开启。
DEV_MOCK_AI=false
